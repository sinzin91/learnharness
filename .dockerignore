# Build context for deploy/Dockerfile. Lives at the root because the legacy
# builder ignores per-Dockerfile ignore files.

# Records and secrets: never enter the build, on top of the refusals in
# scripts/build-server.mjs.
/data
/plugins/*/data
/.fresh-data
/.memory
/real-data-extraction
/SCOPE.md
**/auth.json
**/*credentials*.json*
**/.env*
**/*.env
**/.npmrc
**/*.pem
**/*.key

# Build output and host-platform dependencies.
**/node_modules
**/.next
/dist
# Plugin outputs a dev checkout may hold; the build regenerates them.
/core-plugins
/.core-plugins-*
/public/plugin-authoring
/plugins/*/dist
/plugins/*/.sdk
**/*.tsbuildinfo
**/*.log
**/.DS_Store

# Not needed to build the server.
.git
.github
.dockerignore
build
deploy
tests
# docs/ stays in: the build packs the plugin-authoring guides from it.
